# Copy to a server-only path, for example /etc/fundit/dev/gateway.env (mode 600).
# Use addresses reachable FROM the gateway container. localhost is the container.
# Fill all four values before deployment. Do not commit the populated file.
# Values are literal: no shell expansion, surrounding quotes, or inline comments.
AUTH_SERVICE_BASE_URL=
MEMBER_SERVICE_BASE_URL=
PAYMENT_SERVICE_BASE_URL=
INTERNAL_API_KEY=
